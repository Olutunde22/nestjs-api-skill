PORT=3000
NODE_ENV=development
APP_ENV=development

# Exact origins (scheme://host[:port], no path, no trailing slash). Used by CORS and CSRF.
CORS_ORIGINS=http://localhost:3001

# 'false' when the app is reached directly; 'loopback', a hop count, or the load balancer's
# CIDR when behind a proxy. Never 'true' if the app is reachable without the proxy.
TRUST_PROXY=false
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_STRICT_MAX=5

DATABASE_URL=postgres://postgres:postgres@localhost:5432/things

# Required (32+ chars) when APP_ENV is staging or production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

COOKIE_SECURE=false
COOKIE_DOMAIN=

API_DOCS_ENABLED=true
